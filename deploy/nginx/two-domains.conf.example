# GrimoireVTT — two public domains (app + API)
# Example:
#   App:  https://app.grimoire.example.com
#   API:  https://api.grimoire.example.com
#
# Server .env:
#   CLIENT_URL=https://app.grimoire.example.com,https://www.grimoire.example.com
#   TRUST_PROXY=1
#
# Client build .env.production:
#   VITE_SERVER_URL=https://api.grimoire.example.com
#   VITE_APP_URL=https://app.grimoire.example.com
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

upstream grimoire_api {
  server 127.0.0.1:3001;
  keepalive 32;
}

# ─── API host ─────────────────────────────────────────────────────────────────
server {
  listen 443 ssl http2;
  server_name api.grimoire.example.com;

  # ssl_certificate     /etc/letsencrypt/live/api.grimoire.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/api.grimoire.example.com/privkey.pem;

  client_max_body_size 64m;

  location / {
    proxy_pass http://grimoire_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass http://grimoire_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }
}

# ─── App host (static only) ─────────────────────────────────────────────────
server {
  listen 443 ssl http2;
  server_name app.grimoire.example.com;

  # ssl_certificate     /etc/letsencrypt/live/app.grimoire.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/app.grimoire.example.com/privkey.pem;

  root /var/www/grimoire-vtt/apps/client/dist;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }
}
