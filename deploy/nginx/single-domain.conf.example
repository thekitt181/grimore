# GrimoireVTT — one public domain (recommended)
# Example: https://grimoire.example.com
#
# - Static React app at /
# - API at /api
# - Socket.io at /socket.io
#
# Server .env:
#   CLIENT_URL=https://grimoire.example.com
#   TRUST_PROXY=1
#
# Client build (leave VITE_SERVER_URL empty):
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

upstream grimoire_api {
  server 127.0.0.1:3001;
  keepalive 32;
}

server {
  listen 443 ssl http2;
  server_name grimoire.example.com;

  # ssl_certificate     /etc/letsencrypt/live/grimoire.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/grimoire.example.com/privkey.pem;

  root /var/www/grimoire-vtt/apps/client/dist;
  index index.html;

  client_max_body_size 64m;

  location /health {
    proxy_pass http://grimoire_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /api/ {
    proxy_pass http://grimoire_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass http://grimoire_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 80;
  server_name grimoire.example.com;
  return 301 https://$host$request_uri;
}
