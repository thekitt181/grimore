# Server
PORT=3001
NODE_ENV=development

# Database (Supabase: use pooler host; runtime auto-switches 5432 → 6543 + pgbouncer)
DATABASE_URL="postgresql://postgres:password@localhost:5432/grimoire_vtt"
# Optional cap per Node process (default: 2 dev, 5 prod)
# DATABASE_CONNECTION_LIMIT=2

# Redis (single URL or pool — failover when one hits quota)
REDIS_URL="redis://localhost:6379"
# REDIS_URL_1=rediss://...
# REDIS_URL_2=rediss://...
# REDIS_URL_3=rediss://...
# REDIS_URLS=rediss://a,rediss://b

# Better Auth (self-hosted — no user cap)
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-long-random-string
# Public URL of the app — use apex host (https://grimore.co.uk), not www
BETTER_AUTH_URL=http://localhost:5173

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Better Auth Infrastructure dashboard (https://better-auth.com)
# BETTER_AUTH_API_KEY=

# Password reset emails (Resend — https://resend.com)
# Production requires both; in dev the reset link is logged to the server console.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Grimoire <noreply@yourdomain.com>

# CORS — apex URL in CLIENT_URL; list www in CLIENT_URLS for Google OAuth cookies
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://grimore.co.uk,https://www.grimore.co.uk

# Behind nginx / load balancer
# TRUST_PROXY=1

# Serve apps/client/dist from Node (optional; nginx can serve static files instead)
# SERVE_CLIENT=1
# CLIENT_DIST_PATH=/var/www/grimoire-vtt/apps/client/dist

# Compendium — stored in Supabase Postgres (same DATABASE_URL as app data)
# Optional one-time migration from legacy MongoDB:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# pnpm --filter @grimoire/server migrate:compendium
COMPENDIUM_ADMIN_PASSWORD=change-me-in-production

# File Storage (choose one)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=grimoire-vtt

# D&D Beyond (Cobalt token proxy — no public OAuth)
# Generate a random 32+ char secret for encrypting stored Cobalt tokens
DDB_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Stripe — optional "Support the developer" (one-time + monthly)
# Create products/prices at https://dashboard.stripe.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SUPPORT_MONTHLY=price_...
# STRIPE_PRICE_SUPPORT_ONETIME=price_...
# Default one-time amount if ONETIME price ID omitted (cents, default 500 = $5)
# STRIPE_SUPPORT_ONETIME_AMOUNT_CENTS=500
