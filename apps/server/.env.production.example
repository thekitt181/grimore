# Production @ https://grimoire.gamer.gd/ (Render Web Service)
# Set these in Render → Environment (never commit real secrets)

NODE_ENV=production
TRUST_PROXY=1
SERVE_CLIENT=1

# Render sets PORT automatically — do not override on Render
# PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/grimoire_vtt
REDIS_URL=redis://default:PASSWORD@HOST:6379

CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Must match the browser URL exactly (scheme + host, no trailing slash)
# On Render without this set, RENDER_EXTERNAL_URL is used automatically.
CLIENT_URL=https://grimoire.gamer.gd

# MongoDB Atlas — compendium (database name in app: owlbear-extension)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
COMPENDIUM_MONGO_ONLY=1
COMPENDIUM_ADMIN_PASSWORD=change-me
DDB_TOKEN_ENCRYPTION_KEY=change-me-long-random-string
