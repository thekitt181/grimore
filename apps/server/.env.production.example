# Production @ https://grimoire.gamer.gd/ (Render Web Service)
# Set these in Render → Environment (never commit real secrets)

NODE_ENV=production
TRUST_PROXY=1
SERVE_CLIENT=1

# Render sets PORT automatically — do not override on Render
# PORT=3001

# Supabase: use Session pooler URI (port 5432) — Render cannot reach db.*.supabase.co direct.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional pool tuning (app pool defaults: limit 5, timeout 20s; auth pool: limit 2)
# DATABASE_CONNECTION_LIMIT=5
# AUTH_DATABASE_CONNECTION_LIMIT=2
# Optional local migrate only — omit on Render (direct host often unreachable from cloud).
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Upstash Redis — must include rediss:// scheme (copy full URL from Upstash dashboard).
# Failover: set REDIS_URL_1, REDIS_URL_2, REDIS_URL_3 to separate databases; exhausted
# endpoints are skipped until quota resets (auto-reprobe every ~6h by default).
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# REDIS_URL_1=rediss://...
# REDIS_URL_2=rediss://...
# REDIS_URL_3=rediss://...
# Optional: REDIS_QUOTA_RETRY_MS=21600000  REDIS_QUOTA_PROBE_MS=3600000

BETTER_AUTH_SECRET=change-me-long-random-string
# Must match the URL in the browser (same host you serve the app on).
BETTER_AUTH_URL=https://grimore.onrender.com

# Optional Google OAuth (same credentials as before)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Better Auth Infrastructure dashboard — API key from "Connect existing project"
BETTER_AUTH_API_KEY=

# Must match the browser URL exactly (scheme + host, no trailing slash)
# On Render without this set, RENDER_EXTERNAL_URL is used automatically.
CLIENT_URL=https://grimore.onrender.com
# When using a custom domain, include every origin users may open:
# CLIENT_URLS=https://grimoire.co.uk,https://www.grimoire.co.uk,https://grimore.onrender.com

# Compendium lives in Supabase Postgres (same DATABASE_URL).
# One-time migration from legacy Mongo (optional):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# pnpm --filter @grimoire/server migrate:compendium
COMPENDIUM_ADMIN_PASSWORD=change-me
DDB_TOKEN_ENCRYPTION_KEY=change-me-long-random-string
