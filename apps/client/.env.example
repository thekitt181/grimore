# Auth is handled by Better Auth on the server — no client env keys needed.

# Production — pick ONE layout (see docs/DEPLOYMENT.md)
#
# Single domain (API on same host via /api):
#   leave VITE_SERVER_URL unset
#
# Two domains (app + api):
#   VITE_SERVER_URL=https://api.yourdomain.com
#   VITE_APP_URL=https://app.yourdomain.com
#
# Local dev (optional — defaults work with Vite proxy):
# Local dev only (optional — Vite proxies /api and /socket.io from :5173):
# VITE_SERVER_URL=http://localhost:3001
# Do NOT use localhost in Render/production — leave VITE_SERVER_URL unset there.

# Optional — JB2A animated spell VFX (CC BY-NC-SA). Host the JB2A Library folder
# and point here, e.g. copy JB2A_DnD5e/Library to apps/client/public/jb2a/Library
# then set: VITE_JB2A_BASE_URL=/jb2a/Library
# VITE_JB2A_BASE_URL=
