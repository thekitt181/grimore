# Committed production defaults for `vite build` (local + Render).
# Secrets (Clerk key) must come from Render Environment at build time — not this file.
#
# CRITICAL: leave VITE_SERVER_URL empty for single-domain deploy (grimore.onrender.com).
# A localhost value here or in Render env will break sockets for all users.

VITE_SERVER_URL=
