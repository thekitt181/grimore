# Production @ https://grimoire.gamer.gd/ or https://grimore.onrender.com
# On Render: set VITE_CLERK_PUBLISHABLE_KEY in Environment (build time only).
#
# NEVER set VITE_SERVER_URL to localhost on Render — sockets will fail for everyone.
# Leave empty for same-origin /api + /socket.io (recommended single-service deploy).

VITE_SERVER_URL=

VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
